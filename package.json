{
  "name": "dsh-avatar-frame",
  "version": "0.12.5",
  "type": "module",
  "description": "Character avatar, editable ID and read-aloud beside every assistant reply — system voice or your own local TTS service, with tone and speed controls, presets, a playback bar, one-click launching of your own TTS process, and a Chinese/English UI switch.",
  "license": "MIT",
  "author": "vioeveann",
  "homepage": "https://github.com/vioeveann/dsh-avatar-frame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vioeveann/dsh-avatar-frame.git"
  },
  "bugs": {
    "url": "https://github.com/vioeveann/dsh-avatar-frame/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tts",
    "text-to-speech",
    "avatar",
    "tts-client"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/tts-contract.md",
    "examples/simple_tts.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
